CRONOGPT_OAUTH_STATE_FILE=/opt/cronogpt/state/oauth-state.json
CRONOMETER_BACKEND=browser
CRONOMETER_ENABLE_WRITES=true
CRONOMETER_REQUIRE_FOOD_CONFIRMATION=false
