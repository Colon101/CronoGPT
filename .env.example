# Local Apps SDK server
PORT=8787
APP_PUBLIC_ORIGIN=http://localhost:8787

# Required for hosted deployments. ChatGPT or your MCP client must send:
# Authorization: Bearer <this-token>
CRONOGPT_API_TOKEN=

# Optional separate code for the ChatGPT OAuth linking page. If omitted, the
# linking page accepts CRONOGPT_API_TOKEN as the code.
CRONOGPT_LINK_SECRET=

# Pick the integration backend:
# - mock: safe local dry-run data
# - terra: Terra API for API-backed Cronometer reads
# - browser: hosted browser automation through a remote Chrome WebSocket endpoint
CRONOMETER_BACKEND=mock

# Terra API path. Terra appears to be the supported API route for synced
# Cronometer read data. Add these only if you create a Terra account/app.
TERRA_API_BASE_URL=https://api.tryterra.co/v2
TERRA_API_KEY=
TERRA_DEV_ID=
TERRA_USER_ID=

# Hosted browser fallback. On Render Docker, local Chromium is provided by the
# Playwright base image. You can still use Browserless or another remote Chrome
# endpoint if you want a separate persistent browser.
REMOTE_CHROME_WS_ENDPOINT=
CRONOMETER_STORAGE_STATE_BASE64=
CRONOMETER_LOCAL_CHROMIUM=true
CRONOMETER_SERVERLESS_CHROMIUM=false
CRONOMETER_ENABLE_WRITES=false
CRONOMETER_REQUIRE_FOOD_CONFIRMATION=false
CRONOMETER_NAVIGATION_TIMEOUT_MS=60000
CRONOMETER_LOGIN_BACKOFF_MS=900000
CRONOMETER_OPERATION_TIMEOUT_MS=600000
CRONOMETER_BROWSER_RETRY_COUNT=1
CRONOMETER_TIME_ZONE=Asia/Jerusalem

# Cronometer credentials. Do not expose these to the client/widget.
# The existing local .env uses lowercase email/password; the server supports
# those names for local development but prefer these explicit names.
CRONOMETER_EMAIL=
CRONOMETER_PASSWORD=

# Optional local session bootstrap:
# HEADLESS=false lets you complete interactive checks while generating a storage state.
# The generated .cronometer-storage-state.* files are gitignored.
HEADLESS=true
CHROME_EXECUTABLE_PATH=
CRONOMETER_STORAGE_STATE_JSON_OUT=.cronometer-storage-state.json
CRONOMETER_STORAGE_STATE_BASE64_OUT=.cronometer-storage-state.base64
