# Local Apps SDK server
PORT=8787
APP_PUBLIC_ORIGIN=http://localhost:8787

# Required for hosted deployments. ChatGPT or your MCP client must send:
# Authorization: Bearer <this-token>
CRONOGPT_API_TOKEN=

# Pick the integration backend:
# - mock: safe local dry-run data
# - terra: Terra API for API-backed Cronometer reads
# - browser: hosted browser automation through a remote Chrome WebSocket endpoint
CRONOMETER_BACKEND=mock

# Terra API path. Terra appears to be the supported API route for synced
# Cronometer read data. Add these only if you create a Terra account/app.
TERRA_API_BASE_URL=https://api.tryterra.co/v2
TERRA_API_KEY=
TERRA_DEV_ID=
TERRA_USER_ID=

# Hosted browser fallback. On Vercel use a remote Chrome provider such as
# Browserless and store these as Vercel encrypted environment variables.
REMOTE_CHROME_WS_ENDPOINT=
CRONOMETER_ENABLE_WRITES=false
CRONOMETER_NAVIGATION_TIMEOUT_MS=20000

# Cronometer credentials. Do not expose these to the client/widget.
# The existing local .env uses lowercase email/password; the server supports
# those names for local development but prefer these explicit names.
CRONOMETER_EMAIL=
CRONOMETER_PASSWORD=
