{
  "name": "cronogpt",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run test:food-logic && npm run test:runtime-safety",
    "test:food-logic": "npm run build && node scripts/test-food-logic.mjs",
    "test:runtime-safety": "node scripts/test-runtime-safety.mjs",
    "cronometer:cooldown": "node scripts/cronometer-login-cooldown.mjs",
    "storage:cronometer": "node scripts/generate-cronometer-storage-state.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:oracle": "ORACLE_DOMAIN=cronogpt.129-159-156-186.sslip.io node scripts/smoke-production.mjs",
    "smoke:live-custom-food": "npm run build && node scripts/smoke-live-custom-food.mjs",
    "oracle:deploy": "bash scripts/oracle/deploy.sh",
    "oracle:wipe-local-env": "bash scripts/oracle/wipe-local-env-preserve-cronometer.sh",
    "inspect": "npx @modelcontextprotocol/inspector@latest --server-url http://localhost:${PORT:-8787}/mcp --transport http"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "dotenv": "^17.2.3",
    "playwright-core": "^1.60.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
